# Backend (api.armedia.id)
PORT=3000
NODE_ENV=production

# Database (Coolify managed PostgreSQL)
# AUDIT FIX: Gunakan DATABASE_URL tunggal (bukan DB_USER/DB_HOST terpisah)
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD_INI@localhost:5432/postgres

# JWT Secrets (generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=GANTI_DENGAN_64_CHAR_RANDOM_STRING_PRODUCTION
JWT_REFRESH_SECRET=GANTI_DENGAN_64_CHAR_RANDOM_STRING_PRODUCTION_2
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Frontend origins
ALLOWED_ORIGINS=https://gumelar.armedia.id,https://www.gumelar.armedia.id

# File Upload
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=2

# ============================================================
# Frontend (gumelar.armedia.id)
# ============================================================
VITE_API_URL=https://api.armedia.id
